/* pages/upload/index.wxss */
/* 上传页面样式 */

.upload-page {
  padding: 32rpx;
  background-color: #F5F7FA;
  min-height: 100vh;
}

/* 页面标题 */
.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1A56A0;
  text-align: center;
  margin-bottom: 48rpx;
}

/* 表单区块 */
.form-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

/* Picker 选择器样式 */
.picker-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F3F4F6;
  border-radius: 8rpx;
}

.picker-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.picker-value {
  color: #333;
  font-size: 28rpx;
  font-weight: bold;
}

.picker-arrow {
  color: #999;
  font-size: 22rpx;
}

/* 自定义输入框 */
.custom-input-wrap {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #F3F4F6;
  border-radius: 8rpx;
}

.custom-input {
  font-size: 28rpx;
  color: #333;
  width: 100%;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 文件选择区域 */
.file-select-area {
  width: 100%;
  min-height: 200rpx;
  border: 3rpx dashed #D1D5DB;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #FAFBFC;
  transition: all 0.3s;
}

.file-select-area:active {
  background-color: #F0F2F5;
  border-color: #1A56A0;
}

/* 文件占位符 */
.file-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-upload {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.placeholder-text {
  font-size: 28rpx;
  color: #999999;
}

/* 已选择文件 */
.file-selected {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.icon-file {
  font-size: 60rpx;
  margin-right: 16rpx;
}

.file-name {
  font-size: 28rpx;
  color: #333333;
  word-break: break-all;
}

/* 进度条区域 */
.progress-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #E5E7EB;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1A56A0 0%, #2E7DD0 100%);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
  display: block;
}

/* 按钮区域 */
.button-section {
  margin-top: 48rpx;
}

.upload-button {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1A56A0 0%, #2E7DD0 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(26, 86, 160, 0.3);
  transition: all 0.3s;
}

.upload-button:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.upload-button[disabled] {
  background: #D1D5DB;
  color: #9CA3AF;
  box-shadow: none;
}

/* 结果区域 */
.result-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 成功提示 */
.result-success {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-success .result-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 48rpx;
  color: #FFFFFF;
  background-color: #10B981;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.result-success .result-message {
  font-size: 28rpx;
  color: #10B981;
  margin-bottom: 24rpx;
}

.view-data-button {
  width: 100%;
  height: 80rpx;
  background-color: #10B981;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

/* 失败提示 */
.result-error {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-error .result-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 48rpx;
  color: #FFFFFF;
  background-color: #EF4444;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.result-error .result-message {
  font-size: 28rpx;
  color: #EF4444;
  margin-bottom: 12rpx;
}

.error-detail {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  word-break: break-all;
}
