/* pages/industry/detail.wxss */
.detail-page {
  background-color: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部区域 */
.detail-header {
  background: #fff;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.industry-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A56A0;
  margin-bottom: 24rpx;
  text-align: center;
}

/* 数据统计信息 */
.data-stats {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A56A0;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #E5E7EB;
  margin: 0 48rpx;
}

.time-selector {
  margin-top: 16rpx;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #F5F7FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 导出PDF按钮 */
.export-btn {
  margin-top: 16rpx;
  background: rgba(26, 86, 160, 0.1);
  border: 1rpx solid rgba(26, 86, 160, 0.3);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1A56A0;
  transition: all 0.3s ease;
}

.export-btn:active {
  background: rgba(26, 86, 160, 0.15);
  transform: scale(0.98);
}

.export-btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 三栏切换 */
.column-tabs {
  display: flex;
  background: #fff;
  margin: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.column-tabs .tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.column-tabs .tab-item.active {
  background: #1A56A0;
  color: #fff;
  font-weight: bold;
}

/* 模块Tab */
.module-tabs {
  white-space: nowrap;
  padding: 24rpx;
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.module-tab {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #666;
  background: #F5F7FA;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.module-tab.active {
  background: #1A56A0;
  color: #fff;
  font-weight: bold;
}

/* 数据展示区 */
.data-display {
  padding: 0 24rpx 24rpx;
}

.data-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.field-row {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F7FA;
}

.field-row:last-child {
  border-bottom: none;
}

.field-key {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.field-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
  /* 已修复：TC23 - 超长文本截断，避免布局撑破 */
  max-height: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 10;
  -webkit-box-orient: vertical;
}

/* 加载状态 */
.loading-container {
  padding: 200rpx 0;
  text-align: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 24rpx;
  border: 4rpx solid #E5E5E5;
  border-top-color: #1A56A0;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  padding: 200rpx 0;
  text-align: center;
  animation: empty-fade-in 0.5s ease-in-out;
}

.empty-icon {
  font-size: 140rpx;
  display: block;
  margin-bottom: 32rpx;
  opacity: 0.6;
  animation: empty-float 3s ease-in-out infinite;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.1));
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  line-height: 1.8;
}

/* 空状态淡入动画 */
@keyframes empty-fade-in {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 空状态图标浮动动画 */
@keyframes empty-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20rpx);
  }
}

/* 图表区域 */
.chart-section {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.chart-toggle {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.chart-toggle text {
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  background: #F5F7FA;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.chart-toggle text.active {
  background: #1A56A0;
  color: #fff;
  font-weight: bold;
}

ec-canvas {
  width: 100%;
  height: 600rpx;
}