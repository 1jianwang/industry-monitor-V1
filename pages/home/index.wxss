/* pages/home/index.wxss */
/* 首页样式 */

.home-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* ==================== 数据统计总览卡片 ==================== */
.stats-card {
  margin: 30rpx 30rpx 20rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 40rpx 30rpx 30rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
}

.stats-card-title {
  margin-bottom: 30rpx;
}

.stats-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* 统计网格：2行2列 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* 统计项基础样式 */
.stat-item {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

/* 悬停效果（小程序用active模拟） */
.stat-item:active {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
}

/* 卡片光泽效果 */
.stat-item::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255, 255, 255, 0.3) 50%,
    transparent 70%
  );
  transform: translateX(-100%) translateY(-100%) rotate(45deg);
  transition: transform 0.6s;
}

.stat-item:active::before {
  transform: translateX(100%) translateY(100%) rotate(45deg);
}

/* 统计图标 */
.stat-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  transition: transform 0.3s ease;
  display: inline-block;
}

.stat-item:active .stat-icon {
  transform: scale(1.15) rotate(5deg);
}

/* 统计数字 */
.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  line-height: 1.2;
  transition: transform 0.3s ease;
}

.stat-item:active .stat-number {
  transform: scale(1.1);
}

/* 统计标签 */
.stat-label {
  font-size: 24rpx;
  font-weight: 500;
  opacity: 0.75;
}

/* ==================== 四种颜色主题 ==================== */

/* 蓝色主题 - 覆盖产业数 */
.stat-blue {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
}
.stat-blue .stat-number {
  color: #1976d2;
}
.stat-blue .stat-label {
  color: #1565c0;
}

/* 绿色主题 - 已上传季度 */
.stat-teal {
  background: linear-gradient(135deg, #e0f2f1 0%, #b2dfdb 100%);
}
.stat-teal .stat-number {
  color: #00897b;
}
.stat-teal .stat-label {
  color: #00796b;
}

/* 橙色主题 - 省级龙头企业 */
.stat-amber {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
}
.stat-amber .stat-number {
  color: #f57c00;
}
.stat-amber .stat-label {
  color: #ef6c00;
}

/* 紫色主题 - 省级科技项目 */
.stat-purple {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
}
.stat-purple .stat-number {
  color: #8e24aa;
}
.stat-purple .stat-label {
  color: #7b1fa2;
}

/* ==================== 搜索栏 ==================== */
.search-bar {
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e0e0e0;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #999999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

/* ==================== 骨架屏加载 ==================== */
.skeleton-list {
  padding: 20rpx 30rpx;
}

.skeleton-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  animation: skeleton-fade-in 0.3s ease-in-out;
}

/* 骨架屏图标占位 */
.skeleton-bar {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(90deg, #e8e8e8 25%, #f5f5f5 50%, #e8e8e8 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.8s ease-in-out infinite;
  border-radius: 20rpx;
  margin-right: 24rpx;
}

.skeleton-content {
  flex: 1;
}

.skeleton-title {
  width: 60%;
  height: 36rpx;
  background: linear-gradient(90deg, #e8e8e8 25%, #f5f5f5 50%, #e8e8e8 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.8s ease-in-out infinite;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-time {
  width: 40%;
  height: 28rpx;
  background: linear-gradient(90deg, #e8e8e8 25%, #f5f5f5 50%, #e8e8e8 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.8s ease-in-out infinite;
  animation-delay: 0.2s;
  border-radius: 8rpx;
}

/* 骨架屏加载动画 */
@keyframes skeleton-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* 骨架屏淡入动画 */
@keyframes skeleton-fade-in {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== 产业列表 ==================== */
.industry-list {
  padding: 20rpx 30rpx;
}

.industry-item {
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: box-shadow 0.3s;
}

.industry-item:active {
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 产业卡片主体 */
.industry-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  position: relative;
  transition: all 0.3s ease;
}

.industry-card:active {
  background-color: #f9f9f9;
}

/* 产业图标容器 */
.card-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
  transition: all 0.3s ease;
}

.industry-card:active .card-icon-wrapper {
  transform: scale(1.05) rotate(-5deg);
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.35);
}

/* 产业图标 */
.card-icon {
  font-size: 44rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  transition: color 0.3s ease;
}

.industry-card:active .card-title {
  color: #667eea;
}

.card-subtitle {
  font-size: 24rpx;
  color: #999999;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 展开按钮 */
.card-expand-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
  margin-left: 20rpx;
  transition: all 0.3s ease;
}

.card-expand-btn:active {
  background-color: #667eea;
  transform: scale(0.95);
}

.expand-icon {
  font-size: 24rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.card-expand-btn:active .expand-icon {
  color: #ffffff;
}

.expand-icon.expanded {
  transform: rotate(180deg);
}

/* 季度列表 */
.period-list {
  border-top: 1rpx solid #f0f0f0;
  overflow: hidden;
  transition: max-height 0.3s ease-in-out;
}

.period-list-hide {
  max-height: 0;
}

.period-list-show {
  max-height: 1000rpx;
}

.period-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s;
}

.period-item:last-child {
  border-bottom: none;
}

.period-item:active {
  background-color: #f9f9f9;
}

.period-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.period-label {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
}

.period-arrow {
  font-size: 32rpx;
  color: #cccccc;
}

.period-empty {
  padding: 40rpx;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  animation: empty-fade-in 0.5s ease-in-out;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
  animation: empty-float 3s ease-in-out infinite;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.1));
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  line-height: 1.8;
  max-width: 500rpx;
}

/* 空状态淡入动画 */
@keyframes empty-fade-in {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 空状态图标浮动动画 */
@keyframes empty-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20rpx);
  }
}
