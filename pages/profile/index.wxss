/* pages/profile/index.wxss */
.profile-page {
  min-height: 100vh;
  background-color: #F5F7FA;
}

/* ==================== 顶部用户信息区 ==================== */
.user-header {
  background: linear-gradient(135deg, #1A56A0 0%, #2E75B6 100%);
  padding: 60rpx 40rpx;
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  margin-right: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.user-info {
  flex: 1;
}

.role-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.role-tag.role-admin {
  background-color: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-weight: bold;
}

.role-tag.role-viewer {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.openid {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  font-family: monospace;
}

/* ==================== 功能列表 ==================== */
.menu-list {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #F5F7FA;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #D9D9D9;
}
