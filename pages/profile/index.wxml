<!--pages/profile/index.wxml-->
<view class="profile-page">
  <!-- 顶部用户信息区 -->
  <view class="user-header">
    <view class="avatar-wrapper">
      <view class="avatar">👤</view>
    </view>
    <view class="user-info">
      <view class="role-tag role-{{role}}">
        <text wx:if="{{role === 'admin'}}">管理员</text>
        <text wx:else>查阅者</text>
      </view>
      <view class="openid">{{maskOpenid(openid)}}</view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <!-- 管理员专属：数据管理后台 -->
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">数据管理后台</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <!-- 管理员专属：上传数据 -->
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goToUpload">
      <view class="menu-left">
        <text class="menu-icon">📤</text>
        <text class="menu-text">上传数据</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <!-- 所有用户：关于本应用 -->
    <view class="menu-item" bindtap="showAbout">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于本应用</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <!-- 所有用户：退出登录 -->
    <view class="menu-item" bindtap="logout">
      <view class="menu-left">
        <text class="menu-icon">🚪</text>
        <text class="menu-text">退出登录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
