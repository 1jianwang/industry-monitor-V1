/* 全局样式 */

/* ==================== 设计规范变量 ==================== */
/* 注意：小程序不支持CSS变量，这里作为注释说明统一规范 */

/* 圆角规范：
 * --radius-xs: 8rpx   (小圆角：按钮、输入框)
 * --radius-sm: 12rpx  (中圆角：小卡片)
 * --radius-md: 16rpx  (大圆角：主要卡片)
 * --radius-lg: 20rpx  (超大圆角：图标容器)
 * --radius-xl: 24rpx  (特大圆角：顶部卡片)
 * --radius-full: 50%  (完全圆形：头像、按钮)
 */

/* 阴影规范：
 * --shadow-xs: 0 2rpx 8rpx rgba(0, 0, 0, 0.05)   (极轻阴影)
 * --shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.08)  (轻阴影)
 * --shadow-md: 0 6rpx 16rpx rgba(0, 0, 0, 0.10)  (中阴影)
 * --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.12)  (重阴影)
 */

/* 间距规范：
 * --spacing-xs: 8rpx
 * --spacing-sm: 12rpx
 * --spacing-md: 16rpx
 * --spacing-lg: 24rpx
 * --spacing-xl: 32rpx
 * --spacing-2xl: 40rpx
 */

/* 页面背景色 */
page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* 主色调 */
.primary-color {
  color: #1A56A0;
}

.secondary-color {
  color: #2E75B6;
}

/* ==================== 统一卡片样式 ==================== */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  margin: 24rpx;
  padding: 32rpx;
  transition: all 0.3s ease;
}

.card:active {
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.10);
  transform: translateY(-2rpx);
}

/* 小卡片 */
.card-sm {
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  padding: 24rpx;
}

/* 大卡片 */
.card-lg {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  padding: 40rpx;
}

/* ==================== 统一按钮样式 ==================== */
.btn-primary {
  background: linear-gradient(135deg, #1A56A0 0%, #2E75B6 100%);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(26, 86, 160, 0.25);
  transition: all 0.3s ease;
}

.btn-primary:active {
  box-shadow: 0 2rpx 8rpx rgba(26, 86, 160, 0.20);
  transform: scale(0.98);
}

.btn-secondary {
  background-color: #F5F7FA;
  color: #666666;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.btn-secondary:active {
  background-color: #E5E7EB;
}

/* 圆形按钮 */
.btn-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.btn-circle:active {
  transform: scale(0.95);
}

/* ==================== 统一标题样式 ==================== */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A56A0;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* ==================== 统一输入框样式 ==================== */
.input {
  background-color: #F5F7FA;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.input:focus {
  background-color: #ffffff;
  border-color: #1A56A0;
  box-shadow: 0 0 0 4rpx rgba(26, 86, 160, 0.1);
}

/* ==================== 统一列表项样式 ==================== */
.list-item {
  background-color: #ffffff;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
  transition: background-color 0.2s ease;
}

.list-item:active {
  background-color: #F9F9F9;
}

.list-item:last-child {
  border-bottom: none;
}

/* ==================== 通用容器 ==================== */
.container {
  padding: 24rpx;
}

.container-sm {
  padding: 16rpx;
}

.container-lg {
  padding: 32rpx;
}

/* ==================== 工具类 ==================== */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

/* 间距工具类 */
.mt-xs { margin-top: 8rpx; }
.mt-sm { margin-top: 12rpx; }
.mt-md { margin-top: 16rpx; }
.mt-lg { margin-top: 24rpx; }
.mt-xl { margin-top: 32rpx; }

.mb-xs { margin-bottom: 8rpx; }
.mb-sm { margin-bottom: 12rpx; }
.mb-md { margin-bottom: 16rpx; }
.mb-lg { margin-bottom: 24rpx; }
.mb-xl { margin-bottom: 32rpx; }

.p-xs { padding: 8rpx; }
.p-sm { padding: 12rpx; }
.p-md { padding: 16rpx; }
.p-lg { padding: 24rpx; }
.p-xl { padding: 32rpx; }

/* 圆角工具类 */
.radius-xs { border-radius: 8rpx; }
.radius-sm { border-radius: 12rpx; }
.radius-md { border-radius: 16rpx; }
.radius-lg { border-radius: 20rpx; }
.radius-xl { border-radius: 24rpx; }
.radius-full { border-radius: 50%; }

/* 阴影工具类 */
.shadow-xs { box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05); }
.shadow-sm { box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08); }
.shadow-md { box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.10); }
.shadow-lg { box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12); }